<Project Sdk="Microsoft.NET.Sdk">
  <!-- Referenced by the developer's startup project: `dotnet add package Lqb.Design`.
       Compiled against EF Core 8 (the minimum supported); at run time it binds to the
       app's own EF Core version (8, 9, 10, ...). -->
  <PropertyGroup>
    <PackageId>Lqb.Design</PackageId>
    <Description>Design-time services for Lqb.Tool. Reference from your startup project.</Description>
    <!-- Like Microsoft.EntityFrameworkCore.Design: not flowed to consumers, not needed at run time. -->
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
  </ItemGroup>
</Project>
